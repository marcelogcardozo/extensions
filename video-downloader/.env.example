# Copie para .env e ajuste. O .env fica fora do git.

# Pasta do host onde os videos vao parar.
# Use barras normais, mesmo no Windows:
YTDL_OUTPUT_DIR=C:/Users/SEU_USUARIO/Downloads/YouTube

# Porta no host. Se mudar, mude tambem SERVIDOR em
# extension/src/popup.js e host_permissions em extension/manifest.json.
YTDL_PORT=8756

# 0 desliga a atualizacao do yt-dlp toda vez que o container sobe.
YTDL_AUTO_UPDATE=1
